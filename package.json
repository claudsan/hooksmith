{
  "name": "hooksmith",
  "version": "1.0.0",
  "description": "Hooksmith - Local API, Webhook Forge",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .",
    "build": "tsc -b tsconfig.json tsconfig.node.json && vite build && tsc -p tsconfig.node.json",
    "typecheck": "tsc -b tsconfig.json tsconfig.node.json --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@monaco-editor/react": "^4.6.0",
    "@types/selfsigned": "^2.0.4",
    "better-sqlite3": "^11.3.0",
    "chokidar": "^3.6.0",
    "electron": "^33.0.0",
    "fastify": "^5.0.0",
    "i18next": "^27.2.7",
    "lucide-react": "^0.460.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^18.0.3",
    "selfsigned": "^5.5.0",
    "undici": "^6.20.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "wait-on": "^8.0.0"
  }
}
